# Copy this file to `.env.local` (git-ignored) to run this checkout alongside another cuttle stack,
# e.g. when working out of more than one git worktree at a time.
#
# `CUTTLE_PORT_OFFSET` shifts every port the local stack binds, so one value is all you need:
#   1 -> client on 8081, server on 1338
#   2 -> client on 8082, server on 1339
CUTTLE_PORT_OFFSET=1

# Individual ports can be pinned instead. These win over the offset.
# CUTTLE_CLIENT_PORT=8081
# PORT=1338
